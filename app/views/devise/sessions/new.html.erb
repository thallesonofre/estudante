<div class="spatial-landing">
  <!-- Left Floating Vertical Glass Dock (same as Index) -->
  <aside class="spatial-left-dock">
    <%= link_to root_path, class: "omnibar-btn", title: "Voltar ao Banner 3D (Início)" do %>
      <i class="bi bi-layers-fill"></i>
    <% end %>
    <%= link_to root_path(anchor: "clientes"), class: "omnibar-btn", title: "Possíveis Clientes" do %>
      <i class="bi bi-buildings"></i>
    <% end %>
    <%= link_to root_path(anchor: "solicitar"), class: "omnibar-btn", title: "Solicitar Acesso para Teste" do %>
      <i class="bi bi-key"></i>
    <% end %>
    <span class="omnibar-btn" style="background: rgba(245, 158, 11, 0.35); border-color: rgba(245, 158, 11, 0.65); color: #fff;" title="Portal de Login Ativo">
      <i class="bi bi-person-check-fill"></i>
    </span>
  </aside>

  <section class="spatial-stage">
    <!-- Top Floating Glass Omnibar -->
    <header class="spatial-omnibar">
      <div class="d-flex align-items-center gap-2">
        <%= link_to root_path, class: "omnibar-btn", title: "Voltar para a Apresentação" do %>
          <i class="bi bi-chevron-left"></i>
        <% end %>
        <%= link_to root_path(anchor: "clientes"), class: "omnibar-btn d-none d-sm-inline-flex", title: "Segmentos Atendidos" do %>
          <i class="bi bi-grid-3x3-gap-fill"></i>
        <% end %>
      </div>

      <div class="omnibar-address">
        <span class="small fw-semibold text-white-50 d-none d-md-inline">AA</span>
        <div class="d-flex align-items-center gap-2 mx-auto">
          <i class="bi bi-shield-lock-fill text-warning small"></i>
          <span class="fw-semibold">Estudante • Gestão Escolar (Login)</span>
        </div>
        <i class="bi bi-key-fill text-white-50 d-none d-md-inline"></i>
      </div>

      <div class="d-flex align-items-center gap-2">
        <%= link_to root_path(anchor: "solicitar"), class: "omnibar-pill-cta" do %>
          <i class="bi bi-plus-circle me-1"></i>Solicitar Teste
        <% end %>
      </div>
    </header>

    <!-- Central Spatial Glass Login Window -->
    <div class="container my-auto py-4">
      <div class="row justify-content-center align-items-center">
        <div class="col-xl-10 col-lg-11">
          <div class="spatial-auth-window">
            <div class="row g-0">
              <!-- Left Visual Showcase Inside the Glass Window -->
              <div class="col-lg-6 spatial-auth-showcase d-none d-lg-flex flex-column justify-content-between p-4 p-xl-5">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="spatial-badge">
                    <i class="bi bi-mortarboard-fill"></i> Sistema Estudante
                  </span>
                  <span class="text-white-50 small fw-semibold">RBAC Security</span>
                </div>

                <div class="my-4">
                  <h2 class="display-6 fw-bold text-white mb-3" style="line-height: 1.15;">
                    Portal Acadêmico &amp; Gestão Escolar
                  </h2>
                  <p class="text-white-50 small mb-4" style="line-height: 1.6;">
                    Ambiente unificado em Ruby on Rails e PostgreSQL para controle diário de chamada, lançamento de notas por bimestre e cálculo automático das médias bimestrais e anual.
                  </p>

                  <div class="d-flex flex-column gap-2">
                    <div class="spatial-mini-feature">
                      <div class="spatial-mini-icon text-warning"><i class="bi bi-briefcase-fill"></i></div>
                      <div>
                        <div class="fw-bold small text-white">Perfil Diretor / Admin</div>
                        <div class="text-white-50" style="font-size: 0.74rem;">Acesso total, radar pedagógico, mural e liberação de acessos.</div>
                      </div>
                    </div>

                    <div class="spatial-mini-feature">
                      <div class="spatial-mini-icon text-info"><i class="bi bi-easel2-fill"></i></div>
                      <div>
                        <div class="fw-bold small text-white">Perfil Professor</div>
                        <div class="text-white-50" style="font-size: 0.74rem;">Diário de chamada ágil e lançamento de pontos nos 4 bimestres.</div>
                      </div>
                    </div>

                    <div class="spatial-mini-feature">
                      <div class="spatial-mini-icon text-emerald"><i class="bi bi-award-fill"></i></div>
                      <div>
                        <div class="fw-bold small text-white">Perfil Aluno</div>
                        <div class="text-white-50" style="font-size: 0.74rem;">Consulta de faltas, notas bimestrais e boletim escolar digital.</div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light border-opacity-10 small text-white-50">
                  <span><i class="bi bi-lock-fill text-warning me-1"></i>Acesso Mediante Autorização</span>
                  <span>Ano Letivo 2026</span>
                </div>
              </div>

              <!-- Right Glass Form Side -->
              <div class="col-lg-6 p-4 p-xl-5 d-flex flex-column justify-content-center">
                <% if notice.present? %>
                  <div class="alert alert-custom-success mb-4"><%= notice %></div>
                <% end %>
                <% if alert.present? %>
                  <div class="alert alert-custom-danger mb-4"><%= alert %></div>
                <% end %>

                <div class="mb-4">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="spatial-badge"><i class="bi bi-key-fill"></i> Credencial Institucional</span>
                    <%= link_to root_path, class: "text-white-50 small text-decoration-none" do %>
                      <i class="bi bi-arrow-left me-1"></i>Início
                    <% end %>
                  </div>
                  <h3 class="fw-bold text-white mb-1">Entrar no Sistema</h3>
                  <p class="text-white-50 small mb-0">
                    Informe seu e-mail institucional e senha liberados pelo Administrador.
                  </p>
                </div>

                <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mb-4" }) do |f| %>
                  <div class="mb-3">
                    <%= f.label :email, "E-mail Institucional Autorizado", class: "form-label small fw-semibold text-white-50" %>
                    <div class="spatial-input-group">
                      <span class="spatial-input-icon"><i class="bi bi-envelope text-warning"></i></span>
                      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu.email@estudante.edu.br", class: "form-control spatial-input spatial-input-with-icon" %>
                    </div>
                  </div>

                  <div class="mb-3">
                    <%= f.label :password, "Senha de Acesso", class: "form-label small fw-semibold text-white-50" %>
                    <div class="spatial-input-group">
                      <span class="spatial-input-icon"><i class="bi bi-lock text-warning"></i></span>
                      <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "form-control spatial-input spatial-input-with-icon" %>
                    </div>
                  </div>

                  <% if devise_mapping.rememberable? %>
                    <div class="form-check mb-4">
                      <%= f.check_box :remember_me, class: "form-check-input bg-transparent border-secondary" %>
                      <%= f.label :remember_me, "Manter sessão ativa neste dispositivo", class: "form-check-label small text-white-50" %>
                    </div>
                  <% end %>

                  <button type="submit" class="btn btn-lg w-100 fw-bold text-white shadow-lg" style="background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%); border: 1px solid rgba(255,255,255,0.28); border-radius: 14px;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Acessar Painel Escolar
                  </button>
                <% end %>

                <div class="p-3 rounded-4" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12);">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="fw-bold small text-white"><i class="bi bi-shield-lock text-warning me-1"></i>Deseja testar o sistema?</span>
                  </div>
                  <p class="text-white-50 mb-2" style="font-size: 0.78rem;">
                    O acesso de avaliação só é liberado após aprovação do Administrador do sistema.
                  </p>
                  <%= link_to root_path(anchor: "solicitar"), class: "btn btn-sm btn-outline-light w-100 rounded-pill fw-semibold" do %>
                    <i class="bi bi-send-check me-1"></i>Solicitar Liberação de Acesso para Teste
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Floating Pill matching the Index -->
    <div class="spatial-bottom-dock">
      <div class="spatial-controller-pill">
        <%= link_to root_path, class: "omnibar-btn", title: "Voltar ao Banner 3D" do %>
          <i class="bi bi-chevron-left"></i>
        <% end %>
        <div class="d-flex align-items-center gap-3 flex-grow-1">
          <div class="controller-thumb" style="background-image: url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=400&q=80');"></div>
          <div>
            <div class="fw-bold text-white small">Portal de Autenticação</div>
            <div class="text-white-50" style="font-size: 0.74rem;">Acesso restrito a usuários aprovados pelo Admin</div>
          </div>
        </div>
        <%= link_to root_path(anchor: "solicitar"), class: "omnibar-btn", title: "Solicitar Acesso" do %>
          <i class="bi bi-key-fill text-warning"></i>
        <% end %>
      </div>
    </div>
  </section>
</div>
