<% content_for :page_title, "Lançamento de Notas e Cálculo de Médias" %>
<% content_for :page_subtitle, "Pontos por bimestre, cálculo automático de Média Bimestral e Média Geral Anual (4 bimestres)." %>

<!-- Formula Banner -->
<div class="formula-banner mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="badge bg-warning text-dark fw-bold"><i class="bi bi-calculator-fill me-1"></i>Regras Oficiais de Cálculo</span>
      <span class="fw-bold">Motor Acadêmico Automatizado</span>
    </div>
    <div class="small text-white-50">
      • <strong class="text-white">Média Bimestral</strong> = Soma dos pontos/notas do bimestre ÷ Quantidade de avaliações &nbsp;|&nbsp;
      • <strong class="text-white">Média Anual</strong> = (Média 1º Bim + Média 2º Bim + Média 3º Bim + Média 4º Bim) ÷ 4
    </div>
  </div>

  <% if @selected_subject %>
    <button type="button" class="btn btn-light fw-bold rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkAssessmentModal">
      <i class="bi bi-lightning-charge-fill text-primary me-1"></i>Lançar Avaliação para Toda a Turma
    </button>
  <% end %>
</div>

<!-- Subject & Bimester Selector -->
<div class="glass-card p-3 mb-4">
  <div class="row g-3 align-items-center justify-content-between">
    <div class="col-md-6">
      <%= form_with url: gradebooks_path, method: :get, local: true, class: "d-flex gap-2 align-items-center" do %>
        <input type="hidden" name="bimester" value="<%= @selected_bimester %>">
        <select name="subject_id" class="form-select fw-semibold" onchange="this.form.submit()">
          <% @subjects.each do |sub| %>
            <option value="<%= sub.id %>" <%= "selected" if @selected_subject&.id == sub.id %>>
              <%= sub.name %> — <%= sub.classroom.name %> (Prof. <%= sub.teacher.name %>)
            </option>
          <% end %>
        </select>
      <% end %>
    </div>

    <div class="col-md-6 d-flex justify-content-md-end gap-2 flex-wrap">
      <% [1, 2, 3, 4].each do |bim| %>
        <%= link_to gradebooks_path(subject_id: @selected_subject&.id, bimester: bim),
                    class: "btn #{ @selected_bimester == bim ? 'btn-indigo' : 'btn-light border fw-semibold' }" do %>
          <%= bim %>º Bimestre
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% if @selected_subject %>
  <!-- Main Gradebook Matrix -->
  <div class="glass-card overflow-hidden mb-4">
    <div class="p-3 border-bottom bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h5 class="fw-bold mb-0">
          <i class="bi bi-journal-bookmark-fill text-primary me-2"></i><%= @selected_subject.name %> (<%= @selected_subject.classroom.name %>) — Foco no <%= @selected_bimester %>º Bimestre
        </h5>
        <div class="text-muted small">
          Visualize as avaliações do <%= @selected_bimester %>º bimestre, a soma de pontos, as médias dos 4 bimestres e a média geral anual.
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-premium">
        <thead>
          <tr>
            <th>Aluno(a)</th>
            <th>Avaliações no <%= @selected_bimester %>º Bimestre (Pontos)</th>
            <th class="text-center">Soma (<%= @selected_bimester %>ºB)</th>
            <th class="text-center">Média 1ºB</th>
            <th class="text-center">Média 2ºB</th>
            <th class="text-center">Média 3ºB</th>
            <th class="text-center">Média 4ºB</th>
            <th class="text-center">Média Anual</th>
            <th class="text-end">+ Nota Individual</th>
          </tr>
        </thead>
        <tbody>
          <% @student_reports.each do |rep| %>
            <% student = rep[:student] %>
            <% cur_bim = rep[:bimesters][@selected_bimester] %>
            <tr>
              <td>
                <div class="fw-bold"><%= student.name %></div>
                <div class="text-muted" style="font-size: 0.74rem;"><%= student.registration_number %></div>
              </td>
              <td>
                <% if cur_bim[:assessments].any? %>
                  <div class="d-flex flex-wrap gap-1">
                    <% cur_bim[:assessments].each do |assessment| %>
                      <div class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded border bg-light" style="font-size: 0.78rem;">
                        <span class="text-secondary"><%= assessment.title %>:</span>
                        <strong class="text-dark"><%= format_grade(assessment.score) %></strong>
                        <%= button_to destroy_assessment_gradebooks_path(id: assessment.id),
                                      method: :delete,
                                      class: "btn btn-link text-danger p-0 ms-1",
                                      style: "font-size: 0.75rem; line-height: 1;",
                                      title: "Remover avaliação" do %>
                          <i class="bi bi-x-circle-fill"></i>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <div class="text-muted mt-1" style="font-size: 0.72rem;">
                    <%= cur_bim[:count] %> avaliação(ões) • Cálculo: <%= format_grade(cur_bim[:sum]) %> ÷ <%= cur_bim[:count] %> = <strong><%= format_grade(cur_bim[:average]) %></strong>
                  </div>
                <% else %>
                  <span class="text-muted small fst-italic">Nenhuma nota no <%= @selected_bimester %>º bimestre</span>
                <% end %>
              </td>
              <td class="text-center">
                <span class="badge bg-secondary-subtle text-dark px-2 py-1">
                  <%= format_grade(cur_bim[:sum]) %> pts
                </span>
              </td>
              <% [1, 2, 3, 4].each do |b| %>
                <% b_avg = rep[:bimesters][b][:average] %>
                <td class="text-center <%= 'bg-primary-subtle bg-opacity-25' if b == @selected_bimester %>">
                  <span class="grade-pill <%= grade_color_class(b_avg) %>">
                    <%= format_grade(b_avg) %>
                  </span>
                </td>
              <% end %>
              <td class="text-center">
                <span class="grade-pill <%= grade_color_class(rep[:annual_average]) %> border border-dark-subtle">
                  <%= format_grade(rep[:annual_average]) %>
                </span>
              </td>
              <td class="text-end" style="min-width: 220px;">
                <%= form_with url: create_assessment_gradebooks_path, method: :post, local: true, class: "d-flex gap-1 justify-content-end" do %>
                  <input type="hidden" name="subject_id" value="<%= @selected_subject.id %>">
                  <input type="hidden" name="student_id" value="<%= student.id %>">
                  <input type="hidden" name="bimester" value="<%= @selected_bimester %>">
                  <input type="text" name="title" placeholder="Ex: Prova" required class="form-control form-control-sm" style="width: 95px;">
                  <input type="number" name="score" step="0.1" min="0" max="10" placeholder="Nota" required class="form-control form-control-sm" style="width: 72px;">
                  <button type="submit" class="btn btn-sm btn-indigo" title="Adicionar nota no <%= @selected_bimester %>º Bimestre">
                    <i class="bi bi-plus-lg"></i>
                  </button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bulk Assessment Modal -->
  <div class="modal fade" id="bulkAssessmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content rounded-4 border-0 shadow">
        <%= form_with url: bulk_create_gradebooks_path, method: :post, local: true do %>
          <input type="hidden" name="subject_id" value="<%= @selected_subject.id %>">
          <div class="modal-header bg-light">
            <div>
              <h5 class="modal-title fw-bold">Lançar Avaliação em Lote — <%= @selected_subject.name %></h5>
              <div class="text-muted small">Turma <%= @selected_subject.classroom.name %> • Lance notas de todos os alunos de uma só vez</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="row g-3 mb-3">
              <div class="col-md-5">
                <label class="form-label small fw-bold">Título da Avaliação</label>
                <input type="text" name="title" required class="form-control" placeholder="Ex.: Prova Bimestral, Simulado, Trabalho">
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-bold">Categoria</label>
                <select name="category" class="form-select">
                  <% Assessment::CATEGORIES.each do |cat| %>
                    <option value="<%= cat %>"><%= cat %></option>
                  <% end %>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label small fw-bold">Bimestre</label>
                <select name="bimester" class="form-select">
                  <% [1, 2, 3, 4].each do |bim| %>
                    <option value="<%= bim %>" <%= "selected" if @selected_bimester == bim %>><%= bim %>º Bimestre</option>
                  <% end %>
                </select>
              </div>
            </div>

            <div class="table-responsive border rounded-3">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3 py-2">Aluno(a)</th>
                    <th class="py-2" style="width: 160px;">Nota / Pontos (0 a 10)</th>
                  </tr>
                </thead>
                <tbody>
                  <% @students.each do |st| %>
                    <tr>
                      <td class="ps-3 py-2">
                        <div class="fw-semibold small"><%= st.name %></div>
                        <div class="text-muted" style="font-size: 0.72rem;"><%= st.registration_number %></div>
                      </td>
                      <td class="pe-3 py-2">
                        <input type="number" name="scores[<%= st.id %>]" step="0.1" min="0" max="10" class="form-control form-control-sm" placeholder="Ex: 8.5">
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-indigo">
              <i class="bi bi-check2-circle me-1"></i>Salvar Notas e Calcular Médias
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
